{
  "name": "devboard",
  "version": "1.0.0",
  "private": true,
  "description": "DevBoard monorepo root for the Express backend and Angular frontend applications.",
  "scripts": {
    "backend:dev": "npm --prefix backend run dev",
    "backend:start": "npm --prefix backend start",
    "backend:test": "npm --prefix backend test",
    "backend:test:coverage": "npm --prefix backend run test:coverage",
    "backend:lint": "npm --prefix backend run lint",
    "backend:lint:fix": "npm --prefix backend run lint:fix",
    "backend:docker:dev": "npm --prefix backend run docker:dev",
    "backend:docker:down": "npm --prefix backend run docker:down",
    "frontend:start": "npm --prefix frontend start",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:build:prod": "npm --prefix frontend run build:prod",
    "frontend:test": "npm --prefix frontend test",
    "frontend:test:ci": "npm --prefix frontend run test:ci",
    "frontend:test:coverage": "npm --prefix frontend run test:coverage",
    "frontend:lint": "npm --prefix frontend run lint",
    "frontend:format": "npm --prefix frontend run format",
    "frontend:format:check": "npm --prefix frontend run format:check",
    "dev": "npm run backend:dev",
    "start": "npm run backend:start",
    "test": "npm run backend:test",
    "lint": "npm run backend:lint"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0"
  }
}
